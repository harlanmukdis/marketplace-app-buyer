# Salin jadi `.env`, lalu pilih SATU nilai API_BASE_URL sesuai tempat kamu menjalankan app.
# Setelah mengubah .env WAJIB regenerate: dart run build_runner build
#
# Backend marketplace-api dijalankan dengan `php -S 127.0.0.1:8000` (lihat
# CLAUDE.md "Menyalakan backend dev") — port 8000.
#
#   Chrome / macOS           http://localhost:8000/api/v1     <-- target saat ini
#
#   Android emulator (AVD)   http://10.0.2.2:8000/api/v1
#     10.0.2.2 adalah alias ke mesin host dari dalam emulator. `php -S` harus
#     listen di 0.0.0.0, bukan 127.0.0.1, supaya bisa dijangkau.
#
#   iOS Simulator            http://localhost:8000/api/v1
#     Simulator berbagi network stack dengan macOS.
#
#   HP fisik (satu WiFi)     http://<IP-LAN-Mac>:8000/api/v1
#     Cari IP-nya: ipconfig getifaddr en0; jalankan php -S di 0.0.0.0:8000.
#
#   Staging/production       https://<host>/api/v1
#
# Cleartext http:// sudah diizinkan untuk build DEBUG: Android lewat
# android/app/src/debug/AndroidManifest.xml, iOS lewat NSAllowsLocalNetworking
# di ios/Runner/Info.plist (hanya alamat lokal).

API_BASE_URL=http://localhost:8000/api/v1
